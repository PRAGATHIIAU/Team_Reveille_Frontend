# =============================================================================
# CMIS / Team Reveille – Auth (Cognito + Google SSO)
# =============================================================================
# Copy this file to .env and fill in the values after completing CONFIG_TODO.md.
# Do not commit .env to version control.
# =============================================================================

# --- Amazon Cognito User Pool ---
# From AWS Console: Cognito → User pools → your pool → Pool ID
VITE_COGNITO_USER_POOL_ID=

# --- Cognito App Client (SPA) ---
# From AWS Console: User pool → App integration → App client → Client ID
# Use a "Public client" (no client secret) for SPA.
VITE_COGNITO_CLIENT_ID=

# --- AWS Region ---
# Region where the User Pool is hosted (e.g. us-east-1)
VITE_COGNITO_REGION=us-east-1

# --- Cognito Hosted UI domain ---
# From AWS Console: User pool → App integration → Domain name
# Use the domain WITHOUT "https://" (e.g. team-reveille.auth.us-east-1.amazoncognito.com)
VITE_COGNITO_OAUTH_DOMAIN=

# --- Redirect URIs ---
# Must exactly match the callback URLs configured in:
# 1) Cognito App client → Hosted UI settings
# 2) Google Cloud Console OAuth client (Authorized redirect URIs)
# For local dev use http://localhost:5173/ (or your dev server URL)
# For production add your production URL (comma-separated if multiple)
VITE_COGNITO_REDIRECT_SIGN_IN=http://localhost:5173/
VITE_COGNITO_REDIRECT_SIGN_OUT=http://localhost:5173/

# --- Backend API (optional) ---
# Override if your API base URL differs from the default.
# VITE_API_BASE_URL=https://2gzy1e8qga.execute-api.us-east-1.amazonaws.com/dev
